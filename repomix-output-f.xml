                                    <p className="text-gray-500 text-sm font-medium">No boss deposits found for this month.</p>
                                </div>
                            )}
                        </div>

                                </div>
                        )}
                    </div>
                </div>


                            {/* 🌟 4. UNIFIED FLOATING ACTION BUTTON (Locked in place, never scrolls!) */}
                                {(!showWorkerModal && !showBossModal && !showExportModal) && (
                                    <button
                                        onClick={() => {
