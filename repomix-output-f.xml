                                                {method}
                                            </button>
                                        );
                                    })}
                                </div>

                            
                                    {showWorkerModal && (
                                    <div className="mb-3 relative">
                                        <label className="block text-[11px] font-semibold text-gray-400 uppercase mb-1">
                                        Worker
