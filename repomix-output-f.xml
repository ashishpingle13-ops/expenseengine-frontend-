                                                        }}
                                                        className={`block w-full text-left px-3.5 py-2.5 text-sm font-medium transition-colors ${
                                                            bossFormData.reason === r ? 'bg-green-50 text-[#0E793C] font-bold' : 'text-gray-700 hover:bg-gray-50'
                                                        }`}
                                                    >
                                                        {r}
                                                    </button>
                                                ))}
                                            </div>
                                        )}
                                    </div>
                                )}
                                </form>
                        </div>

                    
                                <button 
                                    type="submit" 
                                    form="unifiedForm" 
